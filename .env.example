# Copy this file to .env and adjust values as needed.
# No paid/external API keys are required for Phase 1 (zero-cost constraint).

APP_ENV=development

# JSON array of origins allowed to call the backend (pydantic-settings parses list env vars as JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Phase 6: SQLite data layer + ML prediction service.
# All three are optional -- defaults are repo-root-relative and work out of
# the box. Override only if you need the database/dataset/models somewhere
# else (e.g. a second local DB for experimentation).
# DATABASE_PATH=data/database/highway_risk.db
# DATASET_CSV_PATH=data/synthetic/highway_project_snapshots.csv
# MODELS_DIR=models
